{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisperlane",
  "version": "0.8.3",
  "identifier": "com.whisperlane.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "whisperlane",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Smarteknoloji",
    "resources": {
      "runtime/*": "runtime/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "9f2c4b71-6d3e-4a58-b0c7-5e18d3a9f246"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QTZEMDE2NzNBMUUzRTAKUldUZzQ2RnpGdENtdVhxdnkwWHFyVERFa1BqdmZ4UkZtV2RNdTIwU3hIU0txckFQWlAwaWRUa0UK",
      "endpoints": [
        "https://github.com/fahrim/whisperlane/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
